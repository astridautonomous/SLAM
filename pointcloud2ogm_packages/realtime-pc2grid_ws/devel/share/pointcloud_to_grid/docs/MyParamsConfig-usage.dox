\subsubsection usage Usage
\verbatim
<node name="my_dyn_rec" pkg="my_dyn_rec" type="my_dyn_rec">
  <param name="position_x" type="double" value="-5.0" />
  <param name="position_y" type="double" value="0.0" />
  <param name="cell_size" type="double" value="0.0001" />
  <param name="length_x" type="double" value="80.0" />
  <param name="length_y" type="double" value="80.0" />
  <param name="intensity_factor" type="double" value="0.2" />
  <param name="height_factor" type="double" value="1.0" />
  <param name="cloud_in_topic" type="str" value="/carla/ego_vehicle/lidar" />
  <param name="mapi_topic_name" type="str" value="/lidargrid_i" />
  <param name="maph_topic_name" type="str" value="/lidargrid_h" />
  <param name="debug" type="bool" value="True" />
</node>
\endverbatim

