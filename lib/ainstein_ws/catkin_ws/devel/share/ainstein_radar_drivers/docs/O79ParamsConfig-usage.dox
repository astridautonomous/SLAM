\subsubsection usage Usage
\verbatim
<node name="ainstein_radar_drivers" pkg="ainstein_radar_drivers" type="ainstein_radar_drivers">
  <param name="update_rate" type="int" value="10" />
  <param name="min_time" type="double" value="2.0" />
  <param name="timeout" type="double" value="0.5" />
  <param name="confidence_level" type="int" value="3" />
  <param name="proc_noise_speed" type="double" value="1.0" />
  <param name="proc_noise_azim" type="double" value="5.0" />
  <param name="proc_noise_elev" type="double" value="5.0" />
  <param name="min_range" type="double" value="0.2" />
  <param name="max_range" type="double" value="15.0" />
  <param name="proc_noise_vel_x" type="double" value="0.1" />
  <param name="proc_noise_vel_y" type="double" value="0.1" />
  <param name="proc_noise_vel_z" type="double" value="0.1" />
  <param name="meas_noise_speed" type="double" value="1.0" />
  <param name="meas_noise_pos" type="double" value="1.0" />
  <param name="filter_type" type="int" value="0" />
</node>
\endverbatim

