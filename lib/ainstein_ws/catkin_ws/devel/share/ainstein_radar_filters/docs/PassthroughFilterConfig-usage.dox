\subsubsection usage Usage
\verbatim
<node name="ainstein_radar_filters" pkg="ainstein_radar_filters" type="ainstein_radar_filters">
  <param name="filter_field_name" type="str" value="range" />
  <param name="filter_limit_min" type="double" value="0.0" />
  <param name="filter_limit_max" type="double" value="200.0" />
  <param name="filter_limit_negative" type="bool" value="False" />
</node>
\endverbatim

